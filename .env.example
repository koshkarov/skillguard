# SkillGuard configuration. Copy to .env and adjust; all settings are optional except the API key.
# Precedence: CLI flag > environment variable > this file > default.

# LLM backend: 'openrouter' (built-in HTTP client, no dependencies) or 'litellm' (any LiteLLM provider; needs `pip install litellm`)
SKILLGUARD_BACKEND=openrouter

# Model for the LLM review. OpenRouter id, or a LiteLLM model string such as anthropic/claude-sonnet-5.5, bedrock/..., ollama/llama3.1, openrouter/openai/gpt-6-luna
SKILLGUARD_MODEL=openai/gpt-6-luna

# Model for triage of static findings. Empty = same as SKILLGUARD_MODEL. 'typesafe/jev-1.13' uses TypeSafe Jev (OpenRouter only)
SKILLGUARD_TRIAGE_MODEL=

# Re-review model when the review model's content filter refuses a skill. 'none' disables. Use a model id valid for the chosen backend
SKILLGUARD_FALLBACK_MODEL=openai/gpt-6-luna

# API key. OpenRouter backend: required. LiteLLM backend: optional (passed as api_key); otherwise LiteLLM uses the provider's own variable, e.g. ANTHROPIC_API_KEY
SKILLGUARD_API_KEY=

# API base URL. OpenRouter backend: default https://openrouter.ai/api/v1 (any OpenAI-compatible endpoint works). LiteLLM backend: optional api_base, e.g. a LiteLLM proxy or Ollama URL
SKILLGUARD_BASE_URL=

# Sampling temperature for review and triage; 'none' = provider default (some reasoning models reject a temperature)
SKILLGUARD_TEMPERATURE=0

# Seconds per LLM request
SKILLGUARD_LLM_TIMEOUT=300.0

# Attempts per LLM request on transient errors
SKILLGUARD_LLM_RETRIES=3

# Max output tokens per review call
SKILLGUARD_REVIEW_MAX_TOKENS=8000

# Max characters per review prompt; larger skills are split into several calls
SKILLGUARD_MAX_PROMPT_CHARS=400000

# Cost cap: a skill needing more review calls than this is not sent to the LLM (the review is marked failed, so the verdict is at least REVIEW)
SKILLGUARD_MAX_REVIEW_CALLS=8

# Endpoint for TypeSafe Jev
SKILLGUARD_JEV_BASE_URL=https://openrouter.ai/api/v1

# Key for Jev; empty = SKILLGUARD_API_KEY
SKILLGUARD_JEV_API_KEY=

# Run the LLM review (false = partial scan, never SAFE)
SKILLGUARD_LLM=true

# Run triage of static findings
SKILLGUARD_TRIAGE=true

# Run the Cisco scanner (false = partial scan, never SAFE)
SKILLGUARD_CISCO=true

# Cisco scanner package spec for uvx (pin the version)
SKILLGUARD_CISCO_PACKAGE=cisco-ai-skill-scanner==2.1.0

# Seconds for the Cisco scanner
SKILLGUARD_CISCO_TIMEOUT=300.0

# P(true_positive) at or above this always keeps a finding
SKILLGUARD_KEEP_THRESHOLD=0.2

# P(false_positive) at or above this removes a finding
SKILLGUARD_DROP_THRESHOLD=0.6

# Result cache keyed by skill content + settings, so unchanged skills are not paid for twice. Empty = $XDG_CACHE_HOME/skillguard or ~/.cache/skillguard; 'none' disables
SKILLGUARD_CACHE_DIR=

# Cached results older than this are re-scanned
SKILLGUARD_CACHE_TTL_DAYS=30.0

# Policy file (TOML) with suppressions and approvals; empty = none
SKILLGUARD_POLICY=

# Text files larger than this are not inspected (reported as a coverage gap)
SKILLGUARD_MAX_FILE_BYTES=2000000

# Skills scanned in parallel by `eval`
SKILLGUARD_WORKERS=4

